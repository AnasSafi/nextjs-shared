{
  "name": "@nextjs-shared/shared",
  "version": "0.2.70",
  "private": false,
  "type": "module",
  "files": ["dist"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shared.css": {
      "style": "./dist/shared.css",
      "default": "./dist/shared.css"
    }
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "build:css": "tailwindcss -c tailwind.shared.config.cjs -i ./src/styles/shared.css -o ./dist/shared.css --minify",
    "build": "npm run build:ts && npm run build:css",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "i18next": "^23.0.0",
    "react-i18next": "^15.0.0",
    "i18next-resources-to-backend": "^1.2.0"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18",
    "hls.js": ">=1.0.0",
    "@heroicons/react": ">=2",
    "react-hook-form": ">=7",
    "react-icons": ">=5",
    "yup": ">=1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "hls.js": "^1.6.15",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "yup": "^1.7.1",
    "@tailwindcss/cli": "^4.1.18",
    "tailwindcss": "^4.1.18",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.20",
    "@tailwindcss/forms": "^0.5.11"
  }

}
